// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Enum untuk Role Pengguna
enum Role {
  UNVERIFIED
  AWARDEE
  MENTOR
  SUPERADMIN
}

// Model User: Terhubung dengan Clerk Auth via clerkId
model User {
  id                String   @id @default(uuid())
  clerkId           String   @unique // ID dari Clerk Authentication
  email             String   @unique
  name              String
  role              Role     @default(UNVERIFIED)
  phone             String?
  avatarUrl         String?
  
  // Status Onboarding
  isProfileComplete Boolean  @default(false)
  
  // Relasi jika user adalah Awardee
  awardeeProfile    AwardeeProfile?
  
  // Relasi jika user adalah Mentor
  mentorProfile    MentorProfile?

  // Sesi pembinaan yang dibuat user ini (mentor atau superadmin)
  sessionsCreated  Session[]  @relation("SessionCreator")

  // Pengumuman yang dibuat user ini (mentor atau superadmin)
  announcementsCreated Announcement[] @relation("AnnouncementCreator")
  announcementReads    AnnouncementRead[]

  // Evaluasi performa mentor yang dinilai oleh superadmin ini
  mentorEvaluationsCreated MentorPerformanceEvaluation[] @relation("EvaluatedByAdmin")
  teachingEvaluationsCreated MentorTeachingEvaluation[] @relation("TeachingEvaluatedByAdmin")
  wilayahObservationsCreated WilayahMonevObservation[] @relation("WilayahObservationObserver")
  awardeeInterviewsEvaluated AwardeeInterviewRecord[] @relation("AwardeeInterviewEvaluator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Profil Khusus Awardee
model AwardeeProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  wilayahId    String
  wilayah      Wilayah  @relation(fields: [wilayahId], references: [id])

  school       String?
  university   String?
  major        String?
  generation   String?
  gpa          Float?
  gender       String?
  birthInfo    String?
  address      String?
  ktp          String?
  kk           String?
  province     String?
  city         String?
  // Nilai
  saScore          Float    @default(0.0) // Self Assessment Score (0-4)
  maScore          Float    @default(0.0) // Mentor Assessment Score (0-4)
  hasFilledSA      Boolean  @default(false)
  hasFilledMA      Boolean  @default(false)
  saResponses      Json?    // { statementId: 1-4 }
  saDimensionScores Json?   // { dimensionId: avg score }
  saSubmittedAt    DateTime?
  maResponses      Json?    // { statementId: 1-4 } — filled by mentor
  maDimensionScores Json?   // { dimensionId: avg score }
  maSubmittedAt    DateTime?
  maById           String?  // User.id of the mentor who assessed
  
  // Relasi Absensi & Izin
  attendances  Attendance[]
  excuses      Excuse[]

  // Sesi Individu (1-on-1 dengan mentor)
  individualSessions Session[] @relation("AwardeeIndividualSessions")

  // Portofolio karya/prestasi awardee
  portfolios   Portfolio[]
  
  // Riwayat Penilaian per Periode
  assessmentRecords AssessmentRecord[]

  // Riwayat Wawancara Indepth
  interviewRecords AwardeeInterviewRecord[]
}

// Profil Khusus Mentor
model MentorProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  wilayahId    String   // Maksimal 2 akun mentor per wilayah
  wilayah      Wilayah  @relation(fields: [wilayahId], references: [id])
  
  sessions               Session[]
  journals               MentorJournal[]
  performanceEvaluations MentorPerformanceEvaluation[]
  teachingEvaluations    MentorTeachingEvaluation[]
}

// Model Wilayah
model Wilayah {
  id             String          @id @default(uuid())
  name           String          @unique
  
  mentorProfiles MentorProfile[]
  awardees       AwardeeProfile[]
  sessions       Session[]
  monevObservations WilayahMonevObservation[]
}

// Cakupan sesi: WILAYAH (dibuat mentor untuk wilayahnya) atau NASIONAL (dibuat superadmin, semua wilayah).
enum SessionScope {
  WILAYAH
  NASIONAL
}

// Kategori sesi: KLASIKAL (group/umum) atau INDIVIDU (1-on-1 rentang waktu).
enum SessionCategory {
  KLASIKAL
  INDIVIDU
}

// Sesi Pembinaan
model Session {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  time        String?  // e.g. "13:30 - 15:30" (Untuk KLASIKAL)
  endDate     DateTime? // Tanggal akhir batas janjian (Untuk INDIVIDU)
  
  scope       SessionScope @default(WILAYAH)
  category    SessionCategory @default(KLASIKAL)

  // Siapa pun (mentor / superadmin) yang membuat sesi ini
  createdById String
  createdBy   User @relation("SessionCreator", fields: [createdById], references: [id])

  // Target spesifik (Hanya diisi jika category = INDIVIDU)
  awardeeId   String?
  awardee     AwardeeProfile? @relation("AwardeeIndividualSessions", fields: [awardeeId], references: [id])

  // Hanya diisi untuk sesi WILAYAH
  mentorId    String?
  mentor      MentorProfile? @relation(fields: [mentorId], references: [id])

  wilayahId   String?
  wilayah     Wilayah? @relation(fields: [wilayahId], references: [id])

  attendances Attendance[]

  createdAt   DateTime @default(now())
}

// Enum Status Absensi
enum AttendanceStatus {
  HADIR
  ALFA
  IZIN
  MENUNGGU_KONFIRMASI
}

// Kategori izin (dipakai saat awardee mengajukan izin untuk sebuah sesi).
enum ExcuseCategory {
  SAKIT
  AGENDA_KELUARGA
  AGENDA_ORGANISASI
  AGENDA_PRIBADI
  LAINNYA
}

// Catatan Kehadiran (Absensi)
model Attendance {
  id              String   @id @default(uuid())

  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  awardeeId       String
  awardee         AwardeeProfile @relation(fields: [awardeeId], references: [id], onDelete: Cascade)

  status          AttendanceStatus @default(MENUNGGU_KONFIRMASI)
  // Absen (HADIR)
  selfiePhoto     String? @db.Text // base64 data URL (client-compressed)
  atmospherePhoto String? @db.Text // base64 data URL (client-compressed)
  notes           String?
  // Izin (IZIN)
  excuseCategory  ExcuseCategory?
  excuseReason    String?
  excusePhoto     String? @db.Text // bukti izin: surat sakit, undangan, dll.

  submittedAt     DateTime @default(now())
  verifiedAt      DateTime?
  verifiedById    String?  // User.id mentor/superadmin who set HADIR/ALFA/IZIN

  @@unique([sessionId, awardeeId]) // one attendance per awardee per session
}

// Enum Status Izin
enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

// Pengajuan Izin (Excuse)
model Excuse {
  id          String   @id @default(uuid())
  
  awardeeId   String
  awardee     AwardeeProfile @relation(fields: [awardeeId], references: [id], onDelete: Cascade)
  
  reason      String
  date        DateTime
  proofUrl    String? // Surat keterangan/bukti izin
  
  status      ExcuseStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
}

// Pengumuman Terintegrasi
enum TargetRole {
  ALL
  AWARDEE
  MENTOR
}

model Announcement {
  id           String   @id @default(uuid())
  title        String
  message      String

  targetRole   TargetRole @default(ALL)
  targetRegion String?    // Wilayah.id atau null (semua wilayah)

  createdById  String
  createdBy    User @relation("AnnouncementCreator", fields: [createdById], references: [id])

  reads        AnnouncementRead[]

  createdAt    DateTime @default(now())
}

// Kategori portofolio awardee (prestasi, organisasi, dsb.)
enum PortfolioCategory {
  PRESTASI
  ORGANISASI
  PELATIHAN
  KARYA_PERSONAL
  LAINNYA
}

// Portofolio karya/prestasi yang di-upload awardee.
model Portfolio {
  id          String @id @default(uuid())

  awardeeId   String
  awardee     AwardeeProfile @relation(fields: [awardeeId], references: [id], onDelete: Cascade)

  title       String
  category    PortfolioCategory @default(LAINNYA)
  // `date`      = tanggal event untuk kategori non-Organisasi
  //             = periode awal (bulan/tahun, day=1) untuk Organisasi
  date        DateTime
  // Hanya untuk Organisasi. Null jika `isOngoing` true.
  dateEnd     DateTime?
  isOngoing   Boolean  @default(false)
  description String?
  link        String?  // URL opsional (YouTube, portfolio online, dll.)
  attachment  String? @db.Text // base64 data URL (client-compressed) — sertifikat/foto bukti

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Pelacak siapa saja yang sudah membaca sebuah pengumuman (untuk badge unread).
model AnnouncementRead {
  id             String @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime @default(now())

  @@unique([announcementId, userId])
}

// Dimensi Penilaian ELIX
model Dimension {
  id        String   @id @default(uuid())
  order     Int      @default(0) // Untuk urutan tampilan
  name      String
  weight    Float    // misal 0.25 (25%)
  color     String   // misal "#0284c7"
  bg        String   // class tailwind, misal "bg-sky-500/10"
  text      String   // class tailwind, misal "text-sky-600"
  
  statements Statement[]
}

// Pernyataan / Indikator Penilaian
model Statement {
  id          String   @id @default(uuid())
  order       Int      @default(0) // Untuk urutan tampilan
  dimensionId String
  dimension   Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  
  aspect      String   // misal "Academic Performance"
  code        String   // misal "AP1"
  textAwardee String   @db.Text // Teks untuk form Awardee
  textMentor  String   @db.Text // Teks untuk form Mentor
}

// ----------------------------------------------------------------------
// DATA SIKLUS PENILAIAN (PERIOD)
// ----------------------------------------------------------------------

model AssessmentPeriod {
  id        String   @id @default(uuid())
  name      String   // "Baseline", "Mid-Review", "End-Review"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  
  records   AssessmentRecord[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssessmentRecord {
  id               String   @id @default(uuid())
  awardeeId        String
  awardee          AwardeeProfile @relation(fields: [awardeeId], references: [id], onDelete: Cascade)
  
  periodId         String
  period           AssessmentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  
  saScore          Float    @default(0.0) // Self Assessment Score (0-4)
  maScore          Float    @default(0.0) // Mentor Assessment Score (0-4)
  hasFilledSA      Boolean  @default(false)
  hasFilledMA      Boolean  @default(false)
  
  saResponses      Json?    // { statementId: 1-4 }
  saDimensionScores Json?   // { dimensionId: avg score }
  saSubmittedAt    DateTime?
  
  maResponses      Json?    // { statementId: 1-4 } — filled by mentor
  maDimensionScores Json?   // { dimensionId: avg score }
  maSubmittedAt    DateTime?
  maById           String?  // User.id of the mentor who assessed

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([awardeeId, periodId])
}

// ----------------------------------------------------------------------
// DATA JURNAL MENTOR (DAY-BY-DAY ACTIVITY JOURNALING)
// ----------------------------------------------------------------------

model MentorJournal {
  id                      String        @id @default(uuid())
  journalCode             String        @unique // 1. Unique ID otomatis (misal: JRN-20261013-8F2A)
  
  mentorId                String
  mentor                  MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  activityName            String        // 2. Nama Kegiatan (Dropdown 16 opsi)
  qualitativeAchievement  String        @db.Text // 3. Capaian Kualitatif (Deskripsi panjang)
  quantitativeAchievement String        @db.Text // 4. Capaian Kuantitatif (Result/Indikator kuantitatif)
  
  activityDate            DateTime      // 5. Tanggal Pelaksanaan (Disimpan DateTime, UI DD/MM/YYYY)
  activityTime            String        // 6. Waktu Pelaksanaan (Format 24 Jam Indonesia)
  
  locationType            String        // 7a. Dropdown: "Daring" atau "Luring"
  locationDetail          String        // 7b. Deskripsi singkat lokasi (Zoom/GMeet atau Nama Tempat/Daerah)
  
  problemIdentification   String        @db.Text // 8. Identifikasi Masalah (Deskripsi panjang)
  improvementPlan         String        @db.Text // 9. Rencana Perbaikan (Deskripsi perencanaan per poin)
  
  evidenceText            String?       @db.Text // 10a. Evidence berupa input teks singkat / tautan
  evidencePhoto           String?       @db.Text // 10b. Evidence berupa foto dokumentasi (base64 compressed)

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

// ----------------------------------------------------------------------
// MONEV: INSTRUMEN 1 - PENILAIAN PERFORMA MENTOR
// ----------------------------------------------------------------------

enum PerformanceSemesterScope {
  SEMESTER_1
  SEMESTER_2
  KEDUANYA
}

model MentorPerformancePlan {
  id        String                    @id @default(uuid())
  title     String                    // Rencana Kerja
  order     Int                       @default(0)
  targets   MentorPerformanceTarget[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
}

model MentorPerformanceTarget {
  id             String                   @id @default(uuid())
  planId         String
  plan           MentorPerformancePlan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  title          String                   // Target Kerja
  weight         Float                    // Bobot (dalam %, total 100)
  semesterScope  PerformanceSemesterScope @default(KEDUANYA) // Semester 1 / Semester 2 / Keduanya
  targetSemester String?                  @db.Text // Deskripsi / Indikator Capaian Semester (opsional)
  targetScoreSem1 Float?                  @default(4.0) // Target Capaian Nilai Semester 1 (0.00 - 4.00)
  targetScoreSem2 Float?                  @default(4.0) // Target Capaian Nilai Semester 2 (0.00 - 4.00)
  order          Int                      @default(0)

  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model MentorPerformanceEvaluation {
  id               String        @id @default(uuid())
  
  mentorId         String
  mentor           MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  periodName       String        // misal: "Oktober - November 2026"
  evaluationYear   Int           @default(2026)

  // Nilai Hasil Kalkulasi (Skala 0 - 100)
  scoreSemester1   Float?        // Poin Nilai Performa Semester 1
  scoreSemester2   Float?        // Poin Nilai Performa Semester 2
  totalScore       Float         // Total Poin Nilai Performa 1 Tahun
  category         String        // SANGAT BAIK | BAIK | CUKUP | KURANG

  // Catatan Observer
  wellDoneNotes    String?       @db.Text // Hal yang sudah berjalan / tercapai dengan baik
  improvementNotes String?       @db.Text // Hal yang perlu dikembangkan

  // Rincian skor dan catatan evidence per butir target kerja
  // JSON format: { [targetId]: { scoreSem1?: 0-4, scoreSem2?: 0-4, evidence?: string, weight: number, ... } }
  itemScores       Json

  evaluatedById    String
  evaluatedBy      User          @relation("EvaluatedByAdmin", fields: [evaluatedById], references: [id])

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// ----------------------------------------------------------------------
// MONEV: INSTRUMEN 2 - PENILAIAN KOMPETENSI MENGAJAR MENTOR
// ----------------------------------------------------------------------

model MentorTeachingAspect {
  id          String                    @id @default(uuid())
  title       String                    // Aspek Kompetensi Mengajar
  order       Int                       @default(0)
  indicators  MentorTeachingIndicator[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model MentorTeachingIndicator {
  id          String               @id @default(uuid())
  aspectId    String
  aspect      MentorTeachingAspect @relation(fields: [aspectId], references: [id], onDelete: Cascade)

  title       String               // Indikator
  score       Float                @default(1.0) // Nilai Skor jika indikator tercapai
  order       Int                  @default(0)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model MentorTeachingEvaluation {
  id               String        @id @default(uuid())
  
  mentorId         String
  mentor           MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  periodName       String        // Nama Periode (misal: "Semester 1 - Oktober 2026")
  evaluationDate   DateTime      @default(now())
  sessionTopic     String?       // Topik / Judul Sesi Mengajar yang diobservasi

  // Skor Hasil
  totalScore       Float         // Total Skor yang diperoleh dari indikator yang diceklis
  maxScore         Float         // Total Skor maksimal dari seluruh indikator aktif
  percentage       Float         // (totalScore / maxScore) * 100
  category         String        // SANGAT BAIK | BAIK | CUKUP | KURANG

  // Catatan Observer
  strengthsNotes   String?       @db.Text // Kelebihan / Hal baik saat mengajar
  improvementNotes String?       @db.Text // Hal yang perlu dikembangkan / rekomendasi

  // Rincian centang dan catatan per indikator
  // JSON format: { [indicatorId]: { checked: boolean, score: number, notes: string } }
  itemScores       Json

  evaluatedById    String
  evaluatedBy      User          @relation("TeachingEvaluatedByAdmin", fields: [evaluatedById], references: [id])

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// ==========================================
// INSTRUMEN 3: LAPORAN OBSERVASI MONEV WILAYAH
// ==========================================

model WilayahMonevObservation {
  id                       String        @id @default(uuid())
  
  wilayahId                String
  wilayah                  Wilayah       @relation(fields: [wilayahId], references: [id], onDelete: Cascade)

  periodName               String        // e.g. "Semester 1 - 2026"
  observationDate          DateTime      @default(now())

  // Bagian A. Perkembangan Program
  programRealization       String        @db.Text // Kesimpulan Pelaksanaan Program mengacu pada keseluruhan Instrumen Monev
  mentorPerformanceSummary String        @db.Text // Kesimpulan Performa Mentor mengacu pada Instrumen Penilaian Mentor dan Mengajar Mentor

  // Bagian B. Temuan Ketidakcapaian Target Program
  // Array of: [{ id: string, finding: string, recommendation: string, dueDate: string }]
  findings                 Json          @default("[]")

  evaluatedById            String
  evaluatedBy              User          @relation("WilayahObservationObserver", fields: [evaluatedById], references: [id])

  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([wilayahId])
  @@index([observationDate])
}

// ==========================================
// INSTRUMEN 4: INDEPTH INTERVIEW AWARDEE
// ==========================================

model AwardeeInterviewAspect {
  id          String                     @id @default(uuid())
  name        String                     // e.g. "Academic Readiness", "Islamic Character", dll.
  description String?
  order       Int                        @default(0) // Nomor urut aspek

  questions   AwardeeInterviewQuestion[]

  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
}

model AwardeeInterviewQuestion {
  id          String                 @id @default(uuid())
  aspectId    String
  aspect      AwardeeInterviewAspect @relation(fields: [aspectId], references: [id], onDelete: Cascade)

  question    String                 // Teks butir pertanyaan
  guideNotes  String?                // Panduan observer/pewawancara (opsional)
  order       Int                    @default(0) // Nomor urut pertanyaan

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([aspectId])
}

model AwardeeInterviewRecord {
  id             String         @id @default(uuid())

  awardeeId      String
  awardee        AwardeeProfile @relation(fields: [awardeeId], references: [id], onDelete: Cascade)

  periodName     String         // e.g. "Semester 1 - 2026"
  interviewDate  DateTime       @default(now())

  // Hasil Jawaban per Pertanyaan:
  // Array of: [{ questionId, aspectName, question, answer, notes }]
  answers        Json           @default("[]")

  // Catatan Kesimpulan & Rencana Aksi
  generalSummary String?        @db.Text // Kesimpulan umum hasil interview
  actionPlan     String?        @db.Text // Rencana aksi / rekomendasi pengembangan diri awardee

  evaluatedById  String
  evaluatedBy    User           @relation("AwardeeInterviewEvaluator", fields: [evaluatedById], references: [id])

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([awardeeId])
  @@index([interviewDate])
}


